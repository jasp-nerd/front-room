{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "Side": {
      "type": "string",
      "enum": ["home", "away"]
    },
    "Pts": {
      "description": "Presentation timestamp on the room's TV, in milliseconds from kick-off of the stream. Everything shown is scheduled against it.",
      "type": "integer",
      "minimum": 0
    },
    "ClockMs": {
      "description": "Match clock in milliseconds since the start of the period.",
      "type": "integer",
      "minimum": 0
    },
    "PitchPoint": {
      "description": "Metres on a 105 \u00d7 68 pitch. x runs towards the away goal for the home side in the first half.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -5,
          "maximum": 110
        },
        "y": {
          "type": "number",
          "minimum": -5,
          "maximum": 73
        }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "Language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "Constraint": {
      "type": "string",
      "enum": ["neutral-framing", "captions-stay", "one-overlay", "min-gap", "var-hold", "spoiler-gate"]
    }
  }
}
