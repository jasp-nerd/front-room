# Copy to .env and fill in the keys (az cognitiveservices account keys list, az cosmosdb keys list, az eventhubs namespace authorization-rule keys list).
FRONTROOM_FOUNDRY_ENDPOINT=https://vu-front-room-foundry.cognitiveservices.azure.com/
FRONTROOM_FOUNDRY_PROJECT=https://vu-front-room-foundry.services.ai.azure.com/api/projects/front-room
FRONTROOM_FOUNDRY_KEY=
FRONTROOM_MODEL=gpt-5.6-luna
FRONTROOM_MODEL_FAST=gpt-5.4-mini
FRONTROOM_JUDGE_MODEL=gpt-5.4
FRONTROOM_SPEECH_REGION=swedencentral
FRONTROOM_COSMOS_ENDPOINT=https://vu-front-room-cosmos.documents.azure.com:443/
FRONTROOM_COSMOS_KEY=
FRONTROOM_COSMOS_DATABASE=frontroom
FRONTROOM_EVENTHUB_CONNECTION=
FRONTROOM_EVENTHUB_NAME=match-events
FRONTROOM_EVENTHUB_CONSUMER_GROUP=room-server
